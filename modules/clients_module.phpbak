<?php
<?php
declare(strict_types=1);

require_once __DIR__ . '/utils/bootstrap.php';

$clients = load_json_dir(__DIR__ . '/../data/clients');

$items = [];

foreach ($clients as $index => $client) {

    $items[] = [

        'label' => 'Client ' . ($index + 1),

        'value' => '<pre>' .
            htmlspecialchars(
                json_encode($client, JSON_PRETTY_PRINT)
            ) .
        '</pre>'
    ];
}

if (empty($items)) {

    $items[] = [
        'label' => 'Status',
        'value' => 'No client JSON files found'
    ];
}

return [

    'type'  => 'list',

    'title' => 'Client Data Diagnostic',

    'items' => $items
];


