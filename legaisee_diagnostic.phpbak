<?php
declare(strict_types=1);
error_reporting(E_ALL);
ini_set('display_errors', '0'); // we handle errors ourselves

/* ============================================================
   LEGAiSEE SYSTEM DIAGNOSTIC
   READ ONLY — makes no changes to any file or database
   Drop in /commandcenter/ and visit in browser
   ============================================================ */

$ROOT = __DIR__;

/* ============================================================
   HELPERS
   ============================================================ */

function ok($msg)   { return "<span class='ok'>✔ {$msg}</span>"; }
function warn($msg) { return "<span class='warn'>⚠ {$msg}</span>"; }
function err($msg)  { return "<span class='err'>✘ {$msg}</span>"; }
function badge($txt, $color = 'gray') {
    return "<span class='badge badge-{$color}'>{$txt}</span>";
}

function scan_php_for_string(string $dir, string $needle, int $depth = 0): array {
    $hits = [];
    if ($depth > 3 || !is_dir($dir)) return $hits;
    foreach (scandir($dir) as $f) {
        if ($f === '.' || $f === '..') continue;
        $path = $dir . '/' . $f;
        if (is_dir($path)) {
            $hits = array_merge($hits, scan_php_for_string($path, $needle, $depth + 1));
        } elseif (str_ends_with($f, '.php')) {
            $src = @file_get_contents($path);
            if ($src && str_contains($src, $needle)) {
                $hits[] = str_replace($dir . '/', '', $path);
            }
        }
    }
    return $hits;
}

function count_json_files(string $dir): int {
    if (!is_dir($dir)) return 0;
    return count(array_filter(scandir($dir), fn($f) => str_ends_with($f, '.json')));
}

function try_sqlite(string $path): array {
    if (!file_exists($path)) return ['exists' => false];
    try {
        $pdo = new PDO('sqlite:' . $path, '', '', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
        $tables = $pdo->query("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")->fetchAll(PDO::FETCH_COLUMN);
        $counts = [];
        foreach ($tables as $t) {
            $n = $pdo->query("SELECT COUNT(*) FROM `{$t}`")->fetchColumn();
            $counts[$t] = (int)$n;
        }
        return ['exists' => true, 'ok' => true, 'tables' => $counts, 'size' => filesize($path)];
    } catch (Throwable $e) {
        return ['exists' => true, 'ok' => false, 'error' => $e->getMessage()];
    }
}

function try_mysql(): array {
    // look for credentials in kernel_boot.php
    $boot = __DIR__ . '/kernel/kernel_boot.php';
    if (!file_exists($boot)) return ['ok' => false, 'error' => 'kernel_boot.php not found'];
    $src = file_get_contents($boot);
    // extract dsn, user, pass
    preg_match('/dbname=([^;]+)/', $src, $db_m);
    preg_match('/host=([^;]+)/', $src, $host_m);
    preg_match('/kernel_db.*?new PDO.*?"([^"]+)"\s*,\s*"([^"]+)"\s*,\s*"([^"]+)"/s', $src, $cred_m);
    // try a broader match
    preg_match('/"mysql:host=([^;]+);dbname=([^;"]+)[^"]*"\s*,\s*"([^"]+)"\s*,\s*"([^"]+)"/s', $src, $m);
    if (!$m) return ['ok' => false, 'error' => 'Could not parse credentials from kernel_boot.php'];
    try {
        $dsn = "mysql:host={$m[1]};dbname={$m[2]};charset=utf8mb4";
        $pdo = new PDO($dsn, $m[3], $m[4], [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC]);
        $tables = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);
        $counts = [];
        foreach ($tables as $t) {
            $n = $pdo->query("SELECT COUNT(*) FROM `{$t}`")->fetchColumn();
            $counts[$t] = (int)$n;
        }
        return ['ok' => true, 'host' => $m[1], 'db' => $m[2], 'tables' => $counts];
    } catch (Throwable $e) {
        return ['ok' => false, 'error' => $e->getMessage()];
    }
}

/* ============================================================
   RUN CHECKS
   ============================================================ */

// 1. SQLite files
$sqlite1 = try_sqlite($ROOT . '/data/database.sqlite');
$sqlite2 = try_sqlite($ROOT . '/data/legaisee.db');
$sqlite3 = try_sqlite($ROOT . '/data/legaisee.db.bak');

// 2. MySQL
$mysql = try_mysql();

// 3. Scan PHP files for database references
$files_sqlite_old  = scan_php_for_string($ROOT, 'database.sqlite');
$files_sqlite_new  = scan_php_for_string($ROOT, 'legaisee.db');
$files_mysql       = scan_php_for_string($ROOT, 'mysql:');
$files_kernel_db   = scan_php_for_string($ROOT, 'kernel_db()');

// 4. JSON data counts
$json_cases   = count_json_files($ROOT . '/data/cases');
$json_clients = count_json_files($ROOT . '/data/clients');
$json_network = count_json_files($ROOT . '/data/network');

// 5. Kernel path check
$kernel_paths = [
    'kernel/kernel_boot.php'   => file_exists($ROOT . '/kernel/kernel_boot.php'),
    'kernel/kernel_paths.php'  => file_exists($ROOT . '/kernel/kernel_paths.php'),
    'kernel/kernel.php'        => file_exists($ROOT . '/kernel/kernel.php'),
    'modules/utils/bootstrap.php' => file_exists($ROOT . '/modules/utils/bootstrap.php'),
];

// 6. Module check — what shell.php tries to load
$shell_modules = [
    'intelligence_dashboard',
    'files',
    'graph',
    'clients',
    'cases',
    'excavation',
    'report',
    'search',
    'ingest',
    'dashboard',
    'vault',
    'recommendation',
    'executive_dashboard',
    'brain',
    'predictive',
];
$module_status = [];
foreach ($shell_modules as $m) {
    $module_status[$m] = file_exists($ROOT . '/modules/' . $m . '_module.php');
}

// 7. Orphan files in data/
$data_php_orphans = [];
foreach (['db.php', 'graph_data.php'] as $f) {
    if (file_exists($ROOT . '/data/' . $f)) $data_php_orphans[] = $f;
}

?>
