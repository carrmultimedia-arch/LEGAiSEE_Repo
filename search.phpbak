            </form>
        </div>

        <?php if ($query): ?>
            <div class="result-count">
                <?= count($results) ?> result<?= count($results) !== 1 ? 's' : '' ?>
                for <em style="color:var(--gold4)"><?= htmlspecialchars($query) ?></em>
            </div>
        <?php endif; ?>

        <div class="results">
            <?php if ($query && empty($results)): ?>
                <div class="no-results">
                    No records found.<br>Try a broader term or add more content via Prospect Dig.
                </div>

            <?php elseif (!$query): ?>
                <div class="no-results" style="padding-top:40px">
                    Enter a search term to excavate the archive.
                </div>

            <?php else: ?>
                <?php foreach ($results as $r):
                    $active = ($r['ref'] === $openRef) ? 'active' : '';
                    $tc     = type_color($r['type']);
                    $href   = '/commandcenter/search.php?q=' . urlencode($query) . '&open=' . urlencode($r['ref']);
                ?>
                <a class="result-item <?= $active ?>" href="<?= $href ?>">
                    <div class="result-top">
                        <span class="result-type" style="color:<?= $tc ?>;border-color:<?= $tc ?>33">
                            <?= htmlspecialchars($r['type']) ?>
                        </span>
                        <span class="result-title"><?= htmlspecialchars($r['title']) ?></span>
                    </div>
                    <div class="result-preview"><?= htmlspecialchars($r['preview']) ?></div>
                    <?php if ($r['hits'] > 1): ?>
                        <div class="result-hits"><?= $r['hits'] ?> matches</div>
                    <?php endif; ?>
                </a>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>

    </div>

    <!-- ── RIGHT ── -->
    <div class="right">

        <div class="pane-header">
            <div class="pane-title">
                <?= $contentTitle ? htmlspecialchars($contentTitle) : 'Select a result to view' ?>
            </div>
            <?php if ($content): ?>
            <div class="findbar">
                <input
                    class="find-input"
                    type="text"
                    id="findInput"
                    placeholder="Find in document…"
                    oninput="findInViewer(this.value)"
                >
                <button class="find-btn" onclick="clearFind()">✕ Clear</button>
            </div>
            <?php endif; ?>
        </div>

        <?php if ($content): ?>
            <div class="viewer" id="viewer"><?= htmlspecialchars($content) ?></div>
        <?php elseif ($query && !empty($results)): ?>
            <div class="viewer-empty">
                <div class="glyph">◈</div>
                Select a result from the left to view its contents.
            </div>
        <?php else: ?>
            <div class="empty-state">
                <div class="empty-glyph">⌕</div>
                <div class="empty-title">Archive Search</div>
                <div class="empty-sub">
                    Search across cases, clients, prospects, documents, and files.
                    The more you ingest, the more the archive knows.
                </div>
            </div>
        <?php endif; ?>

    </div>

</div>

<script>
// ── FIND IN VIEWER ────────────────────────────────────────────────────────────
let originalText = '';

document.addEventListener('DOMContentLoaded', () => {
    const viewer = document.getElementById('viewer');
    if (viewer) originalText = viewer.innerText;

    // Auto-highlight search term in viewer
    const q = <?= json_encode($query) ?>;
    if (q && viewer) highlightTerm(q);
});

function highlightTerm(term) {
    const viewer = document.getElementById('viewer');
    if (!viewer || !term) return;
    const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(escaped, 'gi');
    viewer.innerHTML = originalText.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(regex, match => `<mark>${match}</mark>`);
}

function findInViewer(term) {
    const viewer = document.getElementById('viewer');
    if (!viewer) return;

    if (!term) {
        viewer.innerHTML = originalText.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        return;
    }

    const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(escaped, 'gi');
    const highlighted = originalText
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(regex, match => `<mark>${match}</mark>`);

    viewer.innerHTML = highlighted;

    // Scroll to first match
    const first = viewer.querySelector('mark');
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function clearFind() {
    document.getElementById('findInput').value = '';
    findInViewer('');
}
</script>

</body>
</html>