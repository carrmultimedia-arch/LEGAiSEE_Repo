</div>

<!-- ── SHELL ── -->
<div class="shell">

    <!-- ── LEFT ── -->
    <div class="left">

        <div class="search-area">
            <span class="search-label">Archive Search</span>
            <form class="search-form" method="GET" action="/commandcenter/search.php">
                <input
                    class="search-input"
                    type="text"
                    name="q"
                    value="<?= htmlspecialchars($query) ?>"
