<?php
declare(strict_types=1);

require_once __DIR__ . '/kernel/kernel_boot.php';
require_once __DIR__ . '/modules/utils/bootstrap.php';

$query   = trim($_GET['q'] ?? '');
$openRef = trim($_GET['open'] ?? '');   // which result to display in right pane
$results = [];
$content = '';
$contentTitle = '';

// ── SEARCH ENGINE ─────────────────────────────────────────────────────────────
function lee_run_search(string $q): array {
    $results = [];

    // --- JSON Cases ---
    if (defined('CASES_ROOT') && is_dir(CASES_ROOT)) {
        foreach (glob(CASES_ROOT . '*.json') as $path) {
            $raw = file_get_contents($path);
            $data = json_decode($raw, true) ?? [];
            if (stripos($raw, $q) !== false) {
                $results[] = [
                    'title'   => $data['name'] ?? $data['title'] ?? basename($path, '.json'),
                    'type'    => 'Case',
                    'ref'     => 'case:' . basename($path),
                    'path'    => $path,
                    'preview' => substr(strip_tags($raw), 0, 120),
                    'hits'    => substr_count(strtolower($raw), strtolower($q)),
                ];
            }
        }
    }

    // --- JSON Clients ---
    if (defined('CLIENTS_ROOT') && is_dir(CLIENTS_ROOT)) {
        foreach (glob(CLIENTS_ROOT . '*.json') as $path) {
            $raw = file_get_contents($path);
            $data = json_decode($raw, true) ?? [];
            if (stripos($raw, $q) !== false) {
                $results[] = [
                    'title'   => $data['name'] ?? $data['company'] ?? basename($path, '.json'),
                    'type'    => 'Client',
                    'ref'     => 'client:' . basename($path),
                    'path'    => $path,
                    'preview' => substr(strip_tags($raw), 0, 120),
                    'hits'    => substr_count(strtolower($raw), strtolower($q)),
                ];
            }
        }
    }

    // --- JSON Prospects ---
    $prospectDir = __DIR__ . '/data/prospects/';
    if (is_dir($prospectDir)) {
        foreach (glob($prospectDir . '*.json') as $path) {
            $raw = file_get_contents($path);
            $data = json_decode($raw, true) ?? [];
            if (stripos($raw, $q) !== false) {
                $results[] = [
                    'title'   => $data['prospect_name'] ?? basename($path, '.json'),
                    'type'    => 'Prospect',
                    'ref'     => 'prospect:' . basename($path),
                    'path'    => $path,
                    'preview' => 'Authority score: ' . ($data['authority_score'] ?? '?') . ' · Ingest ' . ($data['ingest_number'] ?? '?'),
                    'hits'    => substr_count(strtolower($raw), strtolower($q)),
                ];
            }
        }
    }

    // --- MySQL documents ---
    try {
        $db   = kernel_db();
        $stmt = $db->prepare("
            SELECT id, title, source_type, content, created_at
            FROM   documents
            WHERE  LOWER(title) LIKE :q OR LOWER(content) LIKE :q
            LIMIT  20
        ");
        $stmt->execute([':q' => '%' . strtolower($q) . '%']);
        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
            $results[] = [
                'title'   => $row['title'] ?? 'Untitled Document',
                'type'    => 'Document',
                'ref'     => 'doc:' . $row['id'],
                'path'    => '',
                'preview' => substr(strip_tags($row['content'] ?? ''), 0, 120),
                'hits'    => substr_count(strtolower($row['content'] ?? ''), strtolower($q)),
                'content' => $row['content'] ?? '',
            ];
        }

        // --- MySQL files ---
        $stmt = $db->prepare("
            SELECT id, filename, file_type, uploaded_at
            FROM   files
            WHERE  LOWER(filename) LIKE :q
            LIMIT  20
        ");
        $stmt->execute([':q' => '%' . strtolower($q) . '%']);
        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
            $results[] = [
                'title'   => $row['filename'],
                'type'    => 'File',
                'ref'     => 'file:' . $row['id'],
                'path'    => '',
                'preview' => ($row['file_type'] ?? 'unknown') . ' · ' . date('M j Y', strtotime($row['uploaded_at'])),
                'hits'    => 1,
                'content' => '',
            ];
        }
    } catch (\Throwable $e) {
        // DB unavailable — JSON results still returned
    }

    usort($results, fn($a, $b) => $b['hits'] <=> $a['hits']);
    return array_slice($results, 0, 30);
}

// ── LOAD CONTENT FOR RIGHT PANE ───────────────────────────────────────────────
function lee_load_content(string $ref, array $results): array {
    foreach ($results as $r) {
        if ($r['ref'] === $ref) {
            $title = $r['title'];
            if (!empty($r['content'])) {
                return [$title, $r['content']];
            }
            if (!empty($r['path']) && file_exists($r['path'])) {
                $raw = file_get_contents($r['path']);
                // Pretty-print JSON
                $decoded = json_decode($raw, true);
                if ($decoded) {
                    return [$title, json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE)];
                }
                return [$title, $raw];
            }
            return [$title, 'No content available for this record.'];
        }
    }
    return ['', ''];
}

if ($query) {
    $results = lee_run_search($query);
    if ($openRef) {
        [$contentTitle, $content] = lee_load_content($openRef, $results);
    } elseif (!empty($results)) {
        // Auto-open first result
        $openRef = $results[0]['ref'];
        [$contentTitle, $content] = lee_load_content($openRef, $results);
    }
}

// ── TYPE BADGE COLORS ─────────────────────────────────────────────────────────
function type_color(string $type): string {
    return match($type) {
        'Case'     => '#4a9eff',
        'Client'   => '#6bcf7f',
        'Prospect' => '#e6c256',
        'Document' => '#c084fc',
        'File'     => '#f97316',
        default    => '#AC8B56',
    };
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEGAiSEE — Archive Search</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@300;400&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<style>
